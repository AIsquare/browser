# Working DB (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Signal DB (Neon)
DATABASE_URL_SIGNAL=postgresql://user:password@host/signal?sslmode=require

# Redis (Upstash)
REDIS_URL=rediss://default:password@host:6379

# LLM
TOGETHER_API_KEY=replace-me
TOGETHER_MODEL=zai-org/GLM-5.3-Flash

# JEV / TypeSafe
TYPESAFE_API_KEY=replace-me
TYPESAFE_MODEL=jev-latest

# Synthesis
SYNTH_TEMPERATURE=0.2
SYNTH_TOPIC=
SYNTH_DRY_RUN=0
